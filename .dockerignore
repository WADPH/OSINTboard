# Build artifacts and local state — never send these to the Docker daemon.
.git
.github
node_modules
dist
dist-ssr
*.local

# Python backend
backend/.venv
backend/results
backend/data

# Runtime data — must never be baked into an image
osintboard-data
osintboard-results
**/__pycache__
**/*.pyc

# Scan artifacts
report.pdf
results.json
scan.json
scan.log

# Local tooling / secrets
.vscode
.idea
.env
.env.*
!.env.example
*.log
